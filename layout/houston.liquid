<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <title>{{ page_title | default: 'Sandoitchi Houston — Opening 2026' }}</title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- else -%}
    <meta name="description" content="Sandoitchi is coming to Houston. Join the list to be the first to know when we open.">
  {%- endif -%}

  <link rel="canonical" href="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | default: 'Sandoitchi Houston — Opening 2026' }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:image" content="{{ 'houston-render-street.jpg' | asset_url | prepend: 'https:' | remove: 'https:https:' }}">
  <meta name="theme-color" content="#0F0D0B">

  <link rel="icon" type="image/png" href="{{ settings.favicon | default: 'houston-mark.png' | asset_url }}">

  {%- comment -%} Intentional font deviation from Booton for the launch page {%- endcomment -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Zen+Kaku+Gothic+New:wght@300;400;500;700&display=swap" rel="stylesheet">

  {{ 'houston.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}
</head>
<body>
  {{ content_for_layout }}
  <script src="{{ 'houston.js' | asset_url }}" defer></script>
</body>
</html>
