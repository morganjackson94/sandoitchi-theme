<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-N7VTTCPJ');</script>
<!-- End Google Tag Manager -->
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <title>{{ page_title | default: 'Sandoitchi Houston — Opening 2026' }}</title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- else -%}
    <meta name="description" content="Sandoitchi is coming to Houston. Join the list to be the first to know when we open.">
  {%- endif -%}

  <link rel="canonical" href="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | default: 'Sandoitchi Houston — Opening 2026' }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:image" content="{{ 'houston-render-street.jpg' | asset_url | prepend: 'https:' | remove: 'https:https:' }}">
  <meta name="theme-color" content="#0F0D0B">

  <link rel="icon" type="image/png" href="{{ settings.favicon | default: 'houston-mark.png' | asset_url }}">

  {%- comment -%} Intentional font deviation from Booton for the launch page {%- endcomment -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Zen+Kaku+Gothic+New:wght@300;400;500;700&display=swap" rel="stylesheet">

  {{ 'houston.css' | asset_url | stylesheet_tag }}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Restaurant",
    "name": "Sandoitchi Houston",
    "url": "https://www.sandoitchi.com/pages/houston",
    "image": "{{ 'houston-render-street.jpg' | asset_url | prepend: 'https:' | remove: 'https:https:' }}",
    "servesCuisine": "Japanese",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1603 N Durham Dr",
      "addressLocality": "Houston",
      "addressRegion": "TX",
      "postalCode": "77008",
      "addressCountry": "US"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 29.7998414,
      "longitude": -95.4120299
    },
    "sameAs": [
      "https://www.instagram.com/sando.itchi"
    ]
  }
  </script>

  {{ content_for_header }}
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N7VTTCPJ"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
  {{ content_for_layout }}
  <script src="{{ 'houston.js' | asset_url }}" defer></script>
</body>
</html>
