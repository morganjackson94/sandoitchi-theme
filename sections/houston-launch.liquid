      "type": "paragraph",
      "content": "Standalone Houston launch page. Rendered by templates/page.houston.liquid inside layout/houston.liquid. Images live in theme assets (houston-*.jpg/png); styles in houston.css; behaviors in houston.js. RSVP posts a tagged customer record (houston-waitlist)."
    }
  ],
  "presets": [{ "name": "Houston Launch" }]
}
{% endschema %}
